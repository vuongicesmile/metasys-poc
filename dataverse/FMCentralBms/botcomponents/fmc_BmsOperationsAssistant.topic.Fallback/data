              id: sendMessage_QZreqo
              activity: |-
                Tôi chưa xác định được bản ghi hoặc loại thao tác. Hãy nêu Building code,
                Equipment code, Point object ID, sync request ID hoặc SharePoint path.
                Ví dụ: "Kiểm tra SQL sync request 00000000-0000-0000-0000-000000000000".

      elseActions:
        - kind: BeginDialog
          id: 5aXj5M
