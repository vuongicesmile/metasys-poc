<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="FMC.Bms" constructor="BmsPointGrid" version="1.0.2" display-name-key="BmsPointGrid_DisplayName" description-key="BmsPointGrid_Description" control-type="virtual">
    <!-- Control chỉ dùng dataset do Power Apps cấp; không gọi service bên ngoài. -->
    <external-service-usage enabled="false">
    </external-service-usage>
    <!-- Dataset tôn trọng view hoặc subgrid của host; control không tự query SQL/Dataverse. -->
    <data-set name="points" display-name-key="Points_DisplayName">
      <!-- Các property-set buộc host đưa các cột cần hiển thị vào dataset. -->
      <property-set name="fmc_objectid" display-name-key="ObjectId_DisplayName" description-key="ObjectId_Description" of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="fmc_name" display-name-key="Name_DisplayName" description-key="Name_Description" of-type="SingleLine.Text" usage="bound" required="true" />
      <property-set name="fmc_currentvalue" display-name-key="CurrentValue_DisplayName" description-key="CurrentValue_Description" of-type="Decimal" usage="bound" required="false" />
      <property-set name="fmc_unit" display-name-key="Unit_DisplayName" description-key="Unit_Description" of-type="SingleLine.Text" usage="bound" required="false" />
      <property-set name="fmc_lastreadingtime" display-name-key="LastReadingTime_DisplayName" description-key="LastReadingTime_Description" of-type="DateAndTime.DateAndTime" usage="bound" required="false" />
      <property-set name="fmc_sourcesystem" display-name-key="SourceSystem_DisplayName" description-key="SourceSystem_Description" of-type="SingleLine.Text" usage="bound" required="false" />
    </data-set>
    <!-- Ngưỡng chỉ quyết định nhãn stale trên UI; không thay đổi dữ liệu Point. -->
    <property name="staleAfterMinutes" display-name-key="StaleAfterMinutes_DisplayName" description-key="StaleAfterMinutes_Description" of-type="Whole.None" usage="input" required="false" />
    <property name="agentWebChatUrl" display-name-key="AgentWebChatUrl_DisplayName" description-key="AgentWebChatUrl_Description" of-type="SingleLine.Text" usage="input" required="false" />
    <resources>
      <code path="index.ts" order="1"/>
      <platform-library name="React" version="16.14.0" />
      <!-- Environment hiện hỗ trợ Fluent 9 đến 9.46.2; version cao hơn sẽ bị Dataverse từ chối khi import. -->
      <platform-library name="Fluent" version="9.46.2" />
      <css path="Presentation/Styles/PointGrid.css" order="1" />
      <resx path="strings/BmsPointGrid.1033.resx" version="1.0.0" />
      <resx path="strings/BmsPointGrid.1066.resx" version="1.0.0" />
    </resources>
  </control>
</manifest>
